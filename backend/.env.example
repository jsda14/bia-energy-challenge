# Copiar a .env y completar con una API key real de Anthropic para
# habilitar explicaciones generadas por Claude. Si se omite, el sistema
# cae automáticamente al TemplateExplainerAdapter (explicaciones
# deterministas basadas en reglas) sin romper ningún flujo.
BIA_ANTHROPIC_API_KEY=

# Opcional — modelo de Claude a usar. Default: claude-sonnet-4-6
BIA_CLAUDE_MODEL=claude-sonnet-4-6
